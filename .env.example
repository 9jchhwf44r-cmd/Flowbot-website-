# Kopieer dit bestand naar .env.local en vul in wat je al hebt.
# Tide is een privé-tool, niet gelinkt vanaf de openbare Talkwave-site.

# --- Toegang tot Tide (verplicht) ---
# Zonder wachtwoord is /tide voor niemand bereikbaar (fail closed).
TIDE_PASSWORD=

# --- AI-brein (algemene gesprekken, alles buiten de vaste commando's) ---
# Groq wordt geprobeerd vóórdat Gemini als terugval dient — Groq heeft een
# veel ruimer gratis quotum, dus vul deze bij voorkeur in.
#
# Gratis Groq API key: ga naar https://console.groq.com/keys, log in en
# klik "Create API Key". Geen creditcard nodig.
GROQ_API_KEY=
# Optioneel: welk chatmodel (standaard openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
# Optioneel: welk spraak-naar-tekst-model (standaard whisper-large-v3-turbo)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Gratis Gemini API key: ga naar https://aistudio.google.com/apikey, log in
# met een Google-account, en klik "Create API key". Geen creditcard nodig
# voor het gratis tier. Let op: maar ~20 gratis aanvragen per dag, gedeeld
# over alle Gemini-functies (chat, 3D-modellen, briefing, transcriptie) —
# vul daarom ook GROQ_API_KEY in als je Tide de hele dag wilt gebruiken.
GEMINI_API_KEY=
# Optioneel: welk model (standaard gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# --- Google Agenda (lezen én afspraken aanmaken) ---
# Maak een OAuth-client in Google Cloud Console (APIs & Services -> Credentials),
# type "Desktop app" of "Web application" met scope
# https://www.googleapis.com/auth/calendar (LET OP: niet de "readonly"-variant,
# want Tide moet ook zelf afspraken kunnen aanmaken).
# Haal daarna één keer een refresh token op (bv. via de Google OAuth Playground:
# https://developers.google.com/oauthplayground — vink de "Calendar API v3"
# scope https://www.googleapis.com/auth/calendar aan, authoriseer met jouw
# Google-account, en wissel de code in voor tokens). Zet het refresh token
# hieronder; Tide ververst zelf het access token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Magister (rooster) ---
# Magister heeft geen publieke API. De veilige, door Magister zelf ondersteunde
# weg is: log in op Magister -> Agenda -> Extern gebruik / Abonneren, en kopieer
# de webcal/ICS-link die daar verschijnt. Zet die link hieronder (webcal:// mag,
# wordt automatisch omgezet naar https://).
MAGISTER_ICS_URL=

# --- Web zoeken ---
# API key van Brave Search (https://brave.com/search/api/) voor live
# internet-zoekopdrachten.
BRAVE_SEARCH_API_KEY=
