# Kopieer dit bestand naar .env.local en vul in wat je al hebt.
# Alles hieronder is optioneel: Tide werkt ook zonder, met beperkte functies
# (tijd/datum, website doorzoeken, uitleg wat hij kan). Elke koppeling die je
# hieronder instelt, zet Tide's bijbehorende functie automatisch aan.

# --- AI-brein (algemene gesprekken, alles buiten de vaste commando's) ---
# Jouw Anthropic API key, zie https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optioneel: welk model (standaard claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Agenda ---
# Maak een OAuth-client in Google Cloud Console (APIs & Services -> Credentials),
# type "Desktop app" of "Web application" met scope
# https://www.googleapis.com/auth/calendar.readonly.
# Haal daarna één keer een refresh token op (bv. via de Google OAuth Playground:
# https://developers.google.com/oauthplayground — vink de Calendar readonly
# scope aan, authoriseer met jouw Google-account, en wissel de code in voor
# tokens). Zet het refresh token hieronder; Tide ververst zelf het access token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Magister (rooster) ---
# Magister heeft geen publieke API. De veilige, door Magister zelf ondersteunde
# weg is: log in op Magister -> Agenda -> Extern gebruik / Abonneren, en kopieer
# de webcal/ICS-link die daar verschijnt. Zet die link hieronder (webcal:// mag,
# wordt automatisch omgezet naar https://).
MAGISTER_ICS_URL=

# --- Web zoeken ---
# API key van Brave Search (https://brave.com/search/api/) voor live
# internet-zoekopdrachten. Zonder key kan Tide alleen de eigen website
# doorzoeken (dat werkt altijd, ook zonder key).
BRAVE_SEARCH_API_KEY=
